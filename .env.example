# Alchemy RPC endpoint for Ethereum mainnet
ALCHEMY_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_API_KEY_HERE

# Dedicated bot wallet only. Never use a main wallet.
BOT_WALLET_ADDRESS=0x0000000000000000000000000000000000000000
PRIVATE_KEY=0xYOUR_DEDICATED_BOT_WALLET_PRIVATE_KEY

# Deployed MorphoBlueLiquidationExecutor address. Required before live execution.
EXECUTOR_ADDRESS=0x0000000000000000000000000000000000000000

# Etherscan API key (free tier works). Required for MEV competition detection.
ETHERSCAN_API_KEY=YOUR_ETHERSCAN_API_KEY

# Optional read-only venue scout API keys.
ZEROX_API_KEY=YOUR_ZEROX_API_KEY
ONEINCH_API_KEY=YOUR_ONEINCH_API_KEY
VENUE_SCOUT_TAKER=0x0000000000000000000000000000000000000000
